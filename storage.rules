rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // La app sube el archivo y pide su URL (uploadBytes + getDownloadURL) en el mismo
    // instante en que crea el pedido en Firestore. Las reglas cross-service de Storage
    // (firestore.get) pueden no ver todavía ese doc recién escrito por la latencia de
    // propagación entre servicios — validar el tenant/taller del pedido aquí rompe esa
    // subida de forma intermitente. Por eso solo se exige estar autenticado; el pedidoId
    // es un autoID de Firestore (no adivinable), así que el aislamiento real sigue estando
    // en las reglas de Firestore (quién puede leer/escribir el pedido y enterarse de la URL).
    match /solicitudes/{pedidoId}/{fileName} {
      allow read, write: if request.auth != null;
    }
    match /estimados/{pedidoId}/{fileName} {
      allow read, write: if request.auth != null;
    }
    match /chats/{pedidoId}/{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}
